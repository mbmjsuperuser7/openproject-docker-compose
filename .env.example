##
# Copy this file to .env and fill in values marked REPLACE_ME.
# Then run: sudo bash vm-setup.sh
#
# Docs: https://www.openproject.org/docs/installation-and-operations/installation/docker-compose/
##

# OpenProject image tag
TAG=17-slim

# HTTPS - false for local/HTTP access, true only when behind a TLS-terminating reverse proxy
OPENPROJECT_HTTPS=false
OPENPROJECT_HSTS=false

# REQUIRED: generate with: openssl rand -hex 32
SECRET_KEY_BASE=REPLACE_ME

# Hostname without protocol - use IP:port for local, domain for public
# Examples: localhost:8080 | 192.168.1.19:8080 | openproject.yourdomain.com
OPENPROJECT_HOST__NAME=localhost:8080

# Port binding - 127.0.0.1 keeps it localhost-only (safe behind CF tunnel)
PORT=127.0.0.1:8080

# Postgres version - do NOT change after first run without migrating your data
POSTGRES_VERSION=17

# Persistent data directories (vm-setup.sh creates these with correct permissions)
PGDATA=/var/openproject/pgdata
OPDATA=/var/openproject/assets

# Collaborative editing - change this secret
COLLABORATIVE_SERVER_SECRET=REPLACE_ME_PLEASE

# Cloudflare Tunnel token (CF Zero Trust -> Networks -> Tunnels -> your tunnel)
TUNNEL_TOKEN=REPLACE_WITH_CF_TUNNEL_TOKEN

# Leave these as-is unless you know what you are changing
IMAP_ENABLED=false
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16
DATABASE_URL=postgres://postgres:p4ssw0rd@db/openproject?pool=20&encoding=unicode&reconnect=true
